# heimdall main configuration — generated by `heimdall init --format nickel`.
#
# Imports the schema library at lib.ncl (also generated by
# `heimdall init`). The `| h.HeimdallConfig` contract validates
# the whole record at evaluation time — typos and wrong types are
# caught before the daemon ever sees this file.

let h = import "lib.ncl" in

{
  apiVersion = "heimdall.io/v1alpha1",
  kind       = "HeimdallConfig",

  runtime = {
    cgroup            = "/sys/fs/cgroup/system.slice",
    listen            = "0.0.0.0:12345",
    relayIp           = "127.0.0.1",
    dnsListen         = "0.0.0.0:5358",
    fakeIpCidr        = "198.19.0.0/16",
    apiListen         = "0.0.0.0:9999",
    stateDir          = "/var/lib/heimdall",
    flowRetentionSecs = 259200,
    tap = { enabled = false, persist = false },
  },

  connections = {
    default = {
      description = "SOCKS5 upstream — replace addr with your proxy",
      type = "socks5",
      addr = "127.0.0.1:1080",
    },
    direct = { type = "direct" },
  },

  # ─── Routing rules ────────────────────────────────────────────────
  # First match wins. `match` selectors filter on the systemd identity
  # heimdall derives from the process's cgroup path: the leaf `units`
  # (e.g. `nginx.service`, a transient `*.scope`) and the enclosing
  # `slices` (e.g. `system.slice`, `user.slice`). Each list entry is a
  # MatchValue (exact / `regexp:` / `prefix:` / `suffix:` / `keyword:`).
  # `use` is either a connection name or the reserved `system` keyword
  # (eBPF bypass — skip the relay entirely).
  routing = {
    rules = [],
    "default" = { use = "default", observe = false },
  },

  # ─── Defaults for `heimdall <subcommand>` ────────────────────────
  # Currently consumed by `heimdall run` (proxychains-style CLI proxy).
  # All fields optional — empty cli = compiled-in fallbacks.
  cli = {
    run = {
      "default" = {
        connection = "default",
        observe    = true,
      },
      profiles = {},
    },
  },
} | h.HeimdallConfig
