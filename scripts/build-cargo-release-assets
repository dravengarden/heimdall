#!/usr/bin/env bash
set -euo pipefail

output=${1:?usage: build-cargo-release-assets OUTPUT_DIRECTORY}
mkdir -p "$output"

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
version=$(nix eval --raw .#packages.x86_64-linux.release.version)
ebpf_release=$(nix build .#heimdall-ebpf --print-out-paths --no-link -L)
cmp "$ebpf_release/heimdall-ebpf" heimdall/embedded/heimdall-ebpf || {
  echo 'embedded eBPF object does not match the pinned Nix build' >&2
  exit 1
}

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT
export CARGO_TARGET_DIR="$work_dir/target"

for package in heimdall-common heimdall-config heimdall-egress; do
  cargo package --package "$package" --locked --no-verify --allow-dirty \
    --config 'patch.crates-io.heimdall-common.path="heimdall-common"' \
    --config 'patch.crates-io.heimdall-config.path="heimdall-config"'
  archive="$package-$version.crate"
  install -m 0644 "$CARGO_TARGET_DIR/package/$archive" "$output/$archive"
  (cd "$output" && sha256sum "$archive" >"$archive.sha256")
done

printf 'built crates.io release assets for Heimdall %s at %s\n' \
  "$version" "$output"
