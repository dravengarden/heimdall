#!/usr/bin/env bash
set -euo pipefail

version="$(nix eval --raw .#packages.x86_64-linux.release.version)"
tag="v${version}"
head="$(git rev-parse HEAD)"

git diff --quiet
git diff --cached --quiet
git fetch origin main
test "$(git rev-list --left-right --count origin/main...HEAD)" = $'0\t0' || {
  echo "HEAD must exactly match origin/main" >&2
  exit 1
}
gh auth status >/dev/null

just release-check

stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
mkdir "$stage/dist"
x86_release="$(nix build .#release --print-out-paths --no-link -L)"
arm_release="$(nix build .#release-aarch64 --print-out-paths --no-link -L)"
cp -L "$x86_release"/* "$arm_release"/* "$stage/dist/"
(cd "$stage/dist" && sha256sum -c ./*.sha256)

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  test "$(git rev-list -n 1 "$tag")" = "$head" || {
    echo "$tag does not point to HEAD" >&2
    exit 1
  }
else
  git tag -a "$tag" -m "Heimdall $tag" "$head"
fi

remote_tag="$(git ls-remote origin "refs/tags/$tag^{}" | cut -f1)"
if test -n "$remote_tag"; then
  test "$remote_tag" = "$head" || {
    echo "origin/$tag does not point to HEAD" >&2
    exit 1
  }
else
  git push origin "refs/tags/$tag"
fi

if gh release view "$tag" >/dev/null 2>&1; then
  echo "GitHub release $tag already exists" >&2
  exit 1
fi
gh release create "$tag" "$stage/dist"/* \
  --verify-tag \
  --generate-notes \
  --title "Heimdall $tag"
