# Sample systemd unit for heimdall.
#
# heimdall runs as a small root-owned relay, DNS, control API, and GC daemon.
# Install to /etc/systemd/system/heimdall.service
# and `systemctl daemon-reload && systemctl enable --now heimdall`.
#
# This file is a reference for non-Nix hosts. Declarative distributions should
# package the same command and capabilities in their native service module.

[Unit]
Description=heimdall transparent SOCKS5 proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/heimdall daemon
Restart=on-failure
RestartSec=2
RuntimeDirectory=heimdall
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

# eBPF program loading needs CAP_BPF + CAP_NET_ADMIN; CAP_SYS_ADMIN is
# required for cgroup attachment; CAP_DAC_OVERRIDE lets orphan GC remove
# empty user-owned heimdall-cli-* cgroups.
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
